    <string name="about_heading">Độ trong suốt của dấu vân tay thiết bị</string>
    <string name="about_inspired">AndroWatch là một giải pháp thay thế Android được lấy cảm hứng từ Loupe của Mysk Research. Nó hiển thị những gì API Android công khai có thể tiết lộ về thiết bị của bạn.</string>
    <string name="about_privacy">Tất cả các bài đọc vẫn còn trên thiết bị của bạn. Không có gì được tải lên trừ khi bạn xuất báo cáo JSON một cách rõ ràng.</string>
    <string name="onboarding_title">Xem những gì Android tiết lộ</string>
    <string name="onboarding_body">AndroWatch hiển thị những gì API Android có thể tiết lộ về thiết bị của bạn — số nhận dạng, cảm biến, mạng, v.v.</string>
    <string name="onboarding_privacy">Không có gì được tải lên. Xuất khẩu rõ ràng và mang tính địa phương.</string>

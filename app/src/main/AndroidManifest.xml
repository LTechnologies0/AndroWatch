        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="snapchat" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="linkedin" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="reddit" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
